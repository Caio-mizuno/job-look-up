# Gerados por `make setup` (não edite à mão).
APP_KEY=
BRIDGE_TOKEN=
# Onde o ajudante (host) encontra o app.
APP_URL=http://127.0.0.1:3000
# Opcional: só se usar o provedor "Anthropic API" em vez da assinatura via ajudante.
ANTHROPIC_API_KEY=
# E-mail (opcional, botão "Enviar e-mail" dos posts): Gmail com senha de app.
# Crie em https://myaccount.google.com/apppasswords (exige verificação em 2 etapas).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
